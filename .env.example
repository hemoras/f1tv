# Dossier de destination des videos telechargees
F1TV_DEST_DIR=F:\videos\f1tv

# Chemin vers le fichier de cookies F1TV (export au format Netscape)
F1TV_COOKIE_FILE=./f1tv.formula1.com_cookies.txt

# Nombre maximum de pistes audio telechargees en parallele
F1TV_MAX_PARALLEL_AUDIO=3

# Connexion a la base de donnees (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=f1-history
DB_USER=root
DB_PASSWORD=
